# 本地轻量服务（npm run setup 会自动写入缺失项）
WERSS_BASE_URL=http://127.0.0.1:8001
DOUYIN_API_BASE_URL=http://127.0.0.1:8002

# 海外源（Hugging Face / Product Hunt / GitHub 等）若直连超时，填本机代理。
# 项目 .env 中的代理会覆盖 Cursor/IDE 注入的临时 HTTP(S)_PROXY。
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
# ALL_PROXY=http://127.0.0.1:7897
# NO_PROXY=127.0.0.1,::1,localhost

# 可选：Product Hunt GraphQL。在 https://www.producthunt.com/v2/oauth/applications 创建应用后，复制 Developer token（不过期，挂在你的账号上）
# PRODUCTHUNT_TOKEN=

# 可选：提高 GitHub / HF 配额
# GITHUB_TOKEN=
# HF_TOKEN=

# 可选：X 完整 timeline（Free 档读 timeline 会 HTTP 402，需 Basic 付费档）
# X_BEARER_TOKEN=
# X_MODE=embed
# 有付费 API 时用 api；X_MAX_PAGES 默认 1，账号多时也建议保持 1
# X_MAX_PAGES=1

# 可选：小红书 MCP 鉴权（与上游 AUTH_TOKEN 一致）
# XHS_MCP_TOKEN=

# 团队深度调研：仅点击按钮后使用，缺配置时保持未知
TAVILY_API_KEY=
# MOONSHOT_API_KEY 和 MOONSHOT_MODEL 如已有配置请沿用

# 点击团队深度调研后使用。默认 DeepSeek 公网 OpenAI-compatible API
RESEARCH_LLM_PROVIDER=deepseek
RESEARCH_LLM_BASE_URL=https://api.deepseek.com
RESEARCH_LLM_MODEL=deepseek-v4-pro
RESEARCH_LLM_API_KEY=
# DeepSeek 思考模式默认开启，强度 high；可改为 disabled / low / max
RESEARCH_LLM_THINKING=enabled
RESEARCH_LLM_REASONING_EFFORT=high
RESEARCH_LLM_TIMEOUT_MS=600000
# 右下角「问问 AI」聊天助手（默认开启思考，强度 medium；深度调研仍用 RESEARCH_LLM_* 的 high）
CHAT_LLM_MODEL=deepseek-v4-pro
CHAT_LLM_THINKING=enabled
CHAT_LLM_REASONING_EFFORT=medium
CHAT_LLM_TIMEOUT_MS=180000
# 如需填完整接口，可使用 RESEARCH_LLM_URL=https://api.deepseek.com/chat/completions
RESEARCH_LLM_URL=
# 旧 antchat 内网通道仅在显式设置 RESEARCH_LLM_PROVIDER=antchat 时使用
ANTCHAT_API_KEY=
